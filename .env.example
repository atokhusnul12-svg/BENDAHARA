# =========================================================================
# KONFIGURASI ENVIRONMENT - BENDAHARA MMD
# Salin file ini menjadi .env.local untuk penggunaan lokal
# Untuk deployment produksi (Vercel), masukkan variabel ini di menu:
# Project Settings -> Environment Variables
# =========================================================================

# 1. Kredensial Login Administrator (Wajib)
# Username dan Password untuk login di awal aplikasi.
# Kredensial: USERNAME=MMD, PASSWORD=BENDAHARA
ADMIN_USERNAME=MMD
ADMIN_PASSWORD=BENDAHARA
ADMIN_PIN=144805

# 2. Kunci Enkripsi Sesi HMAC (Wajib di Produksi)
# String acak minimal 32 karakter untuk menandatangani cookie sesi aman.
# Anda dapat membuatnya via terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=GENERATE_STRING_ACAK_MINIMAL_32_KARAKTER

# 3. URL CSV Google Sheets Publik Terbaru (Sumber Baca Data)
GOOGLE_SHEETS_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vQNWBm5T4mWn0dvFjFZRJ-uQlTNzUzMUgvZlRfzbTiR1_qPcDXO_s4g0lJ3mcTpl4g9rj_BZhR1jbpe/pub?output=csv

# 4. URL Web App Google Apps Script (Sumber Tulis Otomatis)
# Dapatkan URL ini setelah melakukan "Deploy as Web App" di Google Sheets kas asli -> Ekstensi -> Apps Script
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/AKfycb.../exec

# 5. Token Keamanan Server-to-Server (Wajib di Produksi)
# Token rahasia yang sama persis dengan 'MMD_API_TOKEN' pada Google Apps Script (Project Settings -> Script Properties)
GOOGLE_SCRIPT_TOKEN=GENERATE_TOKEN_ACAK_INTEGRASI_APPS_SCRIPT

# 6. Privasi Buku Kas
# Set ke 'false' (default) agar data keuangan hanya bisa dibaca setelah memasukkan PIN Bendahara.
# Set ke 'true' hanya jika ringkasan kas ingin bisa dibaca publik secara transparan.
ALLOW_PUBLIC_READ=false

# 7. ID dan Tautan Google Sheets Asli yang Dapat Diedit (Bukan URL Publikasi 2PACX)
GOOGLE_SPREADSHEET_ID=ID_SPREADSHEET_ASLI_DAPAT_DIEDIT
GOOGLE_SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/ID_SPREADSHEET_ASLI_DAPAT_DIEDIT/edit
NEXT_PUBLIC_SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/ID_SPREADSHEET_ASLI_DAPAT_DIEDIT/edit

# 7. Identitas Aplikasi
NEXT_PUBLIC_APP_TITLE=Bendahara MMD
NEXT_PUBLIC_APP_SUBTITLE=Majelis Musyawarah & Dirosah
