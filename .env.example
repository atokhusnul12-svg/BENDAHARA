# =========================================================================
# KONFIGURASI ENVIRONMENT - BENDAHARA MMD
# Salin file ini menjadi .env.local untuk penggunaan lokal
# JANGAN MENULISKAN KREDENSIAL/TOKEN RAHASIA ASLI DI SINI!
# =========================================================================

# 1. URL Web App Google Apps Script
# Dapatkan URL ini setelah melakukan "Deploy as Web App" di Google Sheets -> Ekstensi -> Apps Script
# Contoh: https://script.google.com/macros/s/AKfycbxAbCdEfGhIjKlMnOpQrStUvWxYz/exec
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_DEPLOYMENT_ID/exec

# 2. Token Keamanan API (Shared Secret)
# Harus sama dengan properti 'MMD_API_TOKEN' pada Apps Script (Project Settings -> Script Properties)
GOOGLE_SCRIPT_TOKEN=mmd-amanah-kas-secret

# 3. ID Spreadsheet Google Sheets Anda (Opsional jika sudah di-bind pada container script)
# Didapat dari URL browser: https://docs.google.com/spreadsheets/d/[SPREADSHEET_ID]/edit
GOOGLE_SPREADSHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms

# 4. Tautan Lengkap Spreadsheet (Digunakan tombol 'Buka Sheets' di aplikasi)
GOOGLE_SPREADSHEET_URL=https://docs.google.com/spreadsheets/d/1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms/edit

# 5. Nama Organisasi / Lembaga
NEXT_PUBLIC_APP_TITLE=Bendahara MMD
NEXT_PUBLIC_APP_SUBTITLE=Majelis Musyawarah & Dirosah
